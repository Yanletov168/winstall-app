<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48: крошечный exe для LTSC без рантаймов; net8.0-windows: self-contained под x64/x86/arm64 -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>winstall</AssemblyName>
    <RootNamespace>winstall</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <!-- Чистый Win32-вид, без лишних зависимостей. Собирается на VS2019+ / BuildTools. -->
    <!-- На Windows 10 IoT Enterprise LTSC 21H2 работает из коробки (.NET Framework 4.8 встроен). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Чтобы net48 собирался SDK 8 без установленной VS -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <!-- Файлы локализации едут рядом с exe -->
    <Content Include="locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Тесты и portable-артефакты — не часть сборки -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
