<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48: tiny exe for LTSC with no runtime to install; net8.0-windows: self-contained x64/x86/arm64 -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>winstall</AssemblyName>
    <RootNamespace>winstall</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <!-- Plain Win32 look, no extra dependencies. Builds with VS2019+ / BuildTools. -->
    <!-- Runs out of the box on Windows 10 IoT Enterprise LTSC 21H2 (in-box .NET Framework 4.8). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets SDK 8 target net48 without a VS install. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <!-- Locale files ship next to the exe. -->
    <Content Include="locales\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Tests and portable artifacts are not part of the build. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
